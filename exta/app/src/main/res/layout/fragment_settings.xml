<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundColor"
    android:elevation="0dp">

    <TextView
        android:id="@+id/activity_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/sfpregular"
        android:text="@string/settings_label"
        android:textColor="@color/foregroundColor"
        android:textSize="42sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/accuracy_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/sfpregular"
        android:text="@string/settings_accuracy"
        android:textColor="@color/foregroundColor"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/activity_name"
        app:layout_constraintVertical_bias="0.0" />

    <EditText
        android:id="@+id/accuracy"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:ems="10"
        android:fontFamily="@font/sfpregular"
        android:inputType="number"
        android:maxLength="1"
        android:text="@string/setting_std_accuracy"
        android:textAlignment="center"
        android:textColor="@color/accentColor"
        android:textSize="21sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/accuracy_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/accuracy_text"
        app:layout_constraintTop_toBottomOf="@+id/activity_name"
        app:layout_constraintVertical_bias="0.0" />

    <CheckBox
        android:id="@+id/currency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:buttonTint="@color/accentColor"
        android:checked="true"
        android:fontFamily="@font/sfpregular"
        android:text="@string/settings_converter"
        android:textColor="@color/foregroundColor"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/accuracy_text"
        app:useMaterialThemeColors="true" />

    <CheckBox
        android:id="@+id/vars"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="-12dp"
        android:buttonTint="@color/accentColor"
        android:checked="true"
        android:fontFamily="@font/sfpregular"
        android:text="@string/settings_variables"
        android:textColor="@color/foregroundColor"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/currency"
        app:useMaterialThemeColors="true" />

    <CheckBox
        android:id="@+id/scalesBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="-12dp"
        android:buttonTint="@color/accentColor"
        android:checked="true"
        android:fontFamily="@font/sfpregular"
        android:text="@string/using_scale_forms"
        android:textColor="@color/foregroundColor"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vars"
        app:useMaterialThemeColors="true" />

    <CheckBox
        android:id="@+id/timeMathBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="-12dp"
        android:buttonTint="@color/accentColor"
        android:checked="true"
        android:fontFamily="@font/sfpregular"
        android:text="@string/using_time_math"
        android:textColor="@color/foregroundColor"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scalesBox"
        app:useMaterialThemeColors="true" />

    <CheckBox
        android:id="@+id/saveOnLeave"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:buttonTint="@color/accentColor"
        android:fontFamily="@font/sfpregular"
        android:text="@string/settings_save"
        android:textColor="@color/foregroundColor"
        android:textSize="17sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/timeMathBox"
        app:useMaterialThemeColors="true" />

    <Button
        android:id="@+id/faq_btn"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="14dp"
        android:elevation="0dp"
        android:enabled="true"
        android:fontFamily="@font/sfpregular"

        android:hapticFeedbackEnabled="true"
        android:letterSpacing="0"
        android:lineSpacingExtra="0sp"
        android:paddingHorizontal="32dp"
        android:paddingVertical="12dp"
        android:shadowColor="#00FFFFFF"
        android:stateListAnimator="@null"
        android:text="@string/faqbutton"
        android:textAlignment="center"
        android:textAllCaps="false"
        android:textColor="@color/foregroundColor"
        android:textSize="21sp"
        android:textStyle="bold"
        app:cornerRadius="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:strokeColor="@color/accentColor"
        app:strokeWidth="2dp" />

    <TextView
        android:id="@+id/version_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:fontFamily="@font/sfpregular"
        android:text="sample text"
        android:textAlignment="textEnd"
        android:textColor="@color/accentColor"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/faq_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/faq_btn" />

    <TextView
        android:id="@+id/warn_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginBottom="50dp"
        android:fontFamily="@font/additional"
        android:textAlignment="textStart"
        android:textColor="#FF0000"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/faq_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/saveOnLeave"
        app:layout_constraintVertical_bias="1.0"
        tools:text="Ваша версия устарела.\nПожалуйста, обновите приложение." />

    <TextView
        android:id="@+id/info_message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="9dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/sfpregular"
        android:text="Доступно обновление"
        android:textAlignment="textStart"
        android:textColor="@color/debugAccentColor"
        android:textSize="18sp"
        android:textStyle="bold"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/faq_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/warn_message"
        app:layout_constraintVertical_bias="1.0" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/sfpregular"
        android:text="@string/ang_units"
        android:textColor="@color/foregroundColor"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@+id/warn_message"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/saveOnLeave"
        app:layout_constraintVertical_bias="0.0" />

    <Switch
        android:id="@+id/switchModeCalculation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="60dp"
        android:layout_marginBottom="20dp"
        android:text="RAD "
        android:textColor="@color/foregroundColor"
        android:textStyle="bold"
        android:thumbTint="@color/accentColor"
        android:trackTint="@color/accentColor"
        app:layout_constraintBottom_toTopOf="@+id/warn_message"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/textView2"
        app:layout_constraintTop_toBottomOf="@+id/saveOnLeave"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/DegTextLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="25dp"
        android:padding="3.75dp"
        android:text="DEG"
        android:textColor="@color/foregroundColor"
        app:layout_constraintBottom_toTopOf="@+id/warn_message"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/switchModeCalculation"
        app:layout_constraintTop_toBottomOf="@+id/saveOnLeave"
        app:layout_constraintVertical_bias="0.0" />

</androidx.constraintlayout.widget.ConstraintLayout>