<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Activities.GreetingsActivity"
    android:background="@color/mainBackgroundColor">

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="80dp"
        android:layout_marginBottom="10dp"
        android:fontFamily="@font/additional"
        android:text="Открыть настройки"
        android:textColor="@color/foregroundColor"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/example_line3"
        app:layout_constraintVertical_bias="1.0" />

    <TextView
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:fontFamily="@font/sfpregular"
        android:text="@string/greetings_header"
        android:textColor="@color/foregroundColor"
        android:textSize="28sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/smile"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/smile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/acemoji"
        android:text="@string/greetings_smile"
        android:textColor="@color/foregroundColor"
        android:textSize="48sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/greetings_line1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/sfpregular"
        android:text="@string/greetings_line1"
        android:textAlignment="textStart"
        android:textColor="@color/foregroundColor"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/greetings_line2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:fontFamily="@font/sfpregular"
        android:text="@string/greetings_line2"
        android:textAlignment="textStart"
        android:textColor="@color/foregroundColor"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/greetings_line1"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/example_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/regular_font"
        android:text="@string/greetings_exampleline"
        android:textAlignment="textStart"
        android:textColor="@color/foregroundColor"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@+id/example_line1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/greetings_line2"
        app:layout_constraintVertical_bias="1.0" />

    <TextView
        android:id="@+id/example_line1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="60dp"
        android:fontFamily="@font/regular_font"
        android:text="@string/greetings_exampleline1"
        android:textAlignment="textStart"
        android:textColor="@color/foregroundColor"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/greetings_line2"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/example_line2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:fontFamily="@font/regular_font"
        android:text="@string/greetings_exampleline2"
        android:textAlignment="textStart"
        android:textColor="@color/foregroundColor"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/example_line1"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/example_line3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:fontFamily="@font/regular_font"
        android:text="@string/greetings_exampleline3"
        android:textAlignment="textStart"
        android:textColor="@color/foregroundColor"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/example_line2"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/example_answer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="40dp"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/regular_font"
        android:text="@string/greetings_exampleanswer"
        android:textAlignment="textStart"
        android:textColor="@color/accentColor"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@+id/example_answer1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/greetings_line2"
        app:layout_constraintVertical_bias="1.0" />

    <TextView
        android:id="@+id/example_answer1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:layout_marginEnd="40dp"
        android:fontFamily="@font/regular_font"
        android:text="@string/greetings_exampleanswer1"
        android:textAlignment="textStart"
        android:textColor="@color/accentColor"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/greetings_line2"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/example_answer2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="40dp"
        android:fontFamily="@font/regular_font"
        android:text="@string/greetings_exampleanswer2"
        android:textAlignment="textStart"
        android:textColor="@color/accentColor"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/example_line1"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/example_answer3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="40dp"
        android:fontFamily="@font/regular_font"
        android:text="@string/greetings_exampleanswer3"
        android:textAlignment="textStart"
        android:textColor="@color/accentColor"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/example_line2"
        app:layout_constraintVertical_bias="0.0" />

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/before_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/example_line3">

        <Button
            android:id="@+id/settingsBtn"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="175dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:shadowColor="#00FFFFFF"
            android:text=" "
            app:cornerRadius="100dp"
            app:icon="@drawable/settings"
            app:iconTint="@color/foregroundColor"
            app:strokeColor="@color/mainBackgroundColor" />

        <TextView
            android:id="@+id/appNamePlain"
            style="@style/textview"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:fontFamily="@font/regular_font"
            android:textColor="@color/additionalColor" />

        <Button
            android:id="@+id/eraseBtn"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="175dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=" "
            app:cornerRadius="100dp"
            app:icon="@drawable/round_backspace_24"
            app:iconTint="@color/foregroundColor" />

    </LinearLayout>

    <TextView
        android:id="@+id/before_line"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginBottom="100dp"
        android:fontFamily="@font/sfpregular"
        android:text="@string/greetings_before"
        android:textAlignment="textStart"
        android:textColor="@color/foregroundColor"
        android:textSize="16sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/header"
        app:layout_constraintVertical_bias="1.0" />

    <Button
        android:id="@+id/faq_button"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="40dp"
        android:layout_marginBottom="30dp"
        android:elevation="0dp"
        android:enabled="true"
        android:fontFamily="@font/sfpregular"
        android:hapticFeedbackEnabled="true"

        android:letterSpacing="0"
        android:lineSpacingExtra="0sp"
        android:paddingHorizontal="32dp"
        android:paddingVertical="15dp"
        android:shadowColor="#00FFFFFF"
        android:text="@string/faqbutton"
        android:textAlignment="center"
        android:textAllCaps="false"
        android:textColor="@color/foregroundColor"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/before_line"
        app:layout_constraintVertical_bias="0.0"
        app:strokeColor="@color/accentColor"
        app:strokeWidth="2dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/go_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="30dp"
        android:background="#FFFFFF"
        android:clickable="true"
        android:contentDescription="launch app"
        android:foreground="@drawable/baseline_arrow_forward_24"
        android:foregroundGravity="center_vertical|center|center_horizontal"
        android:foregroundTint="@color/backgroundColor"
        android:tint="#FFFFFF"
        app:backgroundTint="@color/accentColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/before_line"
        app:layout_constraintVertical_bias="1.0"
        app:rippleColor="#FFFFFF" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:foreground="@drawable/baseline_arrow_forward_24"
        android:foregroundTint="@color/foregroundColor"
        app:layout_constraintBottom_toTopOf="@+id/example_line1"
        app:layout_constraintEnd_toStartOf="@+id/example_answer"
        app:layout_constraintStart_toEndOf="@+id/example_line"
        app:layout_constraintTop_toBottomOf="@+id/greetings_line2"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/baseline_arrow_forward_24" />

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="45dp"
        android:layout_marginBottom="10dp"
        android:foreground="@drawable/baseline_arrow_forward_24"
        android:foregroundTint="@color/foregroundColor"
        android:rotation="90"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout"
        app:layout_constraintEnd_toStartOf="@+id/textView"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/example_line3"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/baseline_arrow_forward_24" />

    <ImageView
        android:id="@+id/imageView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="45dp"
        android:foreground="@drawable/baseline_arrow_forward_24"
        android:foregroundTint="@color/foregroundColor"
        android:rotation="270"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/textView"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout"
        app:srcCompat="@drawable/baseline_arrow_forward_24" />

    <TextView
        android:id="@+id/textView1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="80dp"
        android:fontFamily="@font/additional"
        android:text="Очистить весь экран"
        android:textAlignment="textEnd"
        android:textColor="@color/foregroundColor"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout" />
</androidx.constraintlayout.widget.ConstraintLayout>