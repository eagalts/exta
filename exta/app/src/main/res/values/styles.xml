<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="linearLayoutLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:weightSum">100</item>
    </style>

    <style name="inputLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:backgroundTint">@color/mainBackgroundColor</item>
        <item name="android:gravity">top</item>
        <item name="android:imeOptions">flagNoExtractUi</item>
        <item name="android:inputType">textMultiLine</item>
        <item name="android:layout_weight">90</item>

        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/foregroundColor</item>
        <item name="android:fontFamily">@font/regular_font</item>

        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>
    </style>


    <style name="resultView">
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">@font/regular_font</item>

        <item name="android:textColor">@color/accentColor</item>

        <item name="android:paddingLeft">0dp</item>
        <item name="android:paddingRight">0dp</item>
        <item name="android:paddingTop">0dp</item>
        <item name="android:paddingBottom">0dp</item>

        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">10</item>
        <item name="android:backgroundTint">@color/mainBackgroundColor</item>
        <item name="android:gravity">end</item>
        <item name="android:minWidth">15dp</item>
    </style>

    <style name="textview">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:text">@string/exta</item>
        <item name="android:textColor">@color/additionalColor</item>
        <item name="android:textAlignment">center</item>
        <item name="android:fontFamily">@font/regular_font</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_marginBottom">10dp</item>
    </style>
</resources>